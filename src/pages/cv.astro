---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects.js';
---

<Base
  title="CV — Ianis Puichaud"
  description="Parcours, formation et compétences d’Ianis Puichaud, administrateur systèmes et réseaux à Nantes."
  canonicalPath="/cv/"
>
  <a class="skip-link" href="#main">Aller au contenu</a>
  <Header />
  <main id="main" class="wrap">
    <header class="resume-head">
      <h1 class="page-title">Ianis Puichaud</h1>
      <p class="lede">Administrateur Systèmes &amp; Réseaux · Nantes · Disponible immédiatement</p>
      <p class="coords">
        <a href="mailto:pro@puichaud.com">pro@puichaud.com</a> ·
        <a href="/cv.pdf" target="_blank" rel="noopener">CV PDF</a> ·
        <a href="https://github.com/AnythingLegalConsidered" target="_blank" rel="noopener">GitHub</a> ·
        <a href="https://www.linkedin.com/in/ianispuichaud" target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </header>

    <section class="resume-section">
      <h2 class="section-label">Résumé</h2>
      <p>
        Administrateur systèmes et réseaux. Chez Equans : support N2, identités Active Directory
        et Entra ID, parc Windows et sécurité du poste. Je veux automatiser des processus de
        support, d’infogérance et de sécurité, et je me forme au fonctionnement, à l’hébergement
        et à l’outillage des modèles d’IA. En parallèle, j’exploite une infrastructure Proxmox en IaC.
      </p>
    </section>

    <section class="resume-section">
      <h2 class="section-label">Compétences</h2>
      <p class="skill-line"><strong>Entreprise :</strong> Windows 10/11, Microsoft 365, Active Directory, Entra ID, Intune, CyberArk EPM, Zscaler, ServiceNow.</p>
      <p class="skill-line"><strong>Infrastructure :</strong> Proxmox VE, LXC, Docker, Terraform, Ansible, Tailscale, Caddy.</p>
      <p class="skill-line"><strong>Observabilité :</strong> Grafana, Prometheus, Loki, Uptime Kuma.</p>
      <p class="skill-line"><strong>Développement :</strong> PowerShell, Python, Bash, GitHub Actions, FastAPI, PostgreSQL/PostGIS.</p>
      <p class="skill-line"><strong>IA :</strong> méthodes de travail agentiques (agents de code, plans délégués), embeddings et RAG, hébergement de modèles (quantification, performance).</p>
    </section>

    <section class="resume-section">
      <h2 class="section-label">Expérience</h2>
      <details class="entry" open>
        <summary>
          <span class="entry-title">Administrateur Systèmes &amp; Réseaux (apprentissage)</span>
          <span class="entry-meta">Equans – Axima · 09/2025 – 09/2026 · Nantes</span>
        </summary>
        <div class="entry-body">
          <ul>
            <li>Gestion des identités Active Directory et Entra ID.</li>
            <li>Support de niveau 2 sur un parc de plus de 21&nbsp;000 postes.</li>
            <li>Sécurité du poste, onboarding et masterisation.</li>
            <li><a href="/projets/automatisation-ad/">Trois outils PowerShell</a> pour les opérations Active Directory répétitives, avec simulation et sauvegarde avant écriture.</li>
          </ul>
        </div>
      </details>
      <details class="entry" open>
        <summary>
          <span class="entry-title">Technicien Support N2</span>
          <span class="entry-meta">Equans – Axima · Intérim (Expectra) · 01/2024 – 07/2025 · Nantes</span>
        </summary>
        <div class="entry-body">
          <p>Résolution d’incidents Windows, Microsoft 365, Teams, SharePoint, Intune, applications métier et accès SAP.</p>
        </div>
      </details>
      <details class="entry" open>
        <summary>
          <span class="entry-title">Technicien Support N1</span>
          <span class="entry-meta">DCS Easyware · 06/2023 – 10/2023 · Orvault, client Nantes Métropole</span>
        </summary>
        <div class="entry-body">
          <p>Diagnostic, résolution de premier niveau et escalade qualifiée vers les équipes N2.</p>
        </div>
      </details>
      <details class="entry" open>
        <summary>
          <span class="entry-title">Agent Service Desk</span>
          <span class="entry-meta">Helpline · 10/2022 – 03/2023 · Nantes, client AREAS</span>
        </summary>
        <div class="entry-body">
          <p>Support téléphonique, diagnostic de premier niveau, dispatching et suivi des tickets.</p>
        </div>
      </details>
    </section>

    <section class="resume-section">
      <h2 class="section-label">Formation</h2>
      <details class="entry" open>
        <summary>
          <span class="entry-title">BAC+3 SYSOPS, titre RNCP niveau 6</span>
          <span class="entry-meta">EPSI Nantes · 2025 – 2026 · titre en cours d’obtention</span>
        </summary>
        <div class="entry-body">
          <p>Administration systèmes et réseaux, cloud, automatisation, sécurité et conduite de projets d’infrastructure.</p>
        </div>
      </details>
    </section>

    <section class="resume-section">
      <h2 class="section-label">Projets</h2>
      {projects.filter((project) => project.slug !== 'automatisation-ad').map((project) => (
        <p class="skill-line"><strong><a href={`/projets/${project.slug}/`}>{project.name}</a> :</strong> {project.outcome}</p>
      ))}
    </section>

    <section class="resume-section">
      <h2 class="section-label">Langues</h2>
      <p class="skill-line">Français (langue maternelle), anglais B2.</p>
    </section>
  </main>
  <Footer />
</Base>
